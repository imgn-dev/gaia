<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.gaia</groupId>
    <artifactId>gaia-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>gaia-processing-testing</artifactId>

  <name>Gaia Processing Testing</name>
  <description>Harness that compiles in-memory sources through annotation processors, with AssertJ assertions on the outcome and a JUnit extension giving tests the Elements and Types of a running compilation.</description>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <!-- CompilationAssert and DiagnosticAssert extend AssertJ. AssertJ is
         allowed in every *-testing module: it works with any test framework. -->
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- CompilationExtension is a JUnit extension. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <!-- Runs the white-box tests of the internal package, whose error paths
         processing-tests cannot reach. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- This module's descriptor requires JUnit's API (for
           CompilationExtension), so on the module path surefire would put
           JUnit's modules there and its own launcher on the class path, which
           cannot reach them. Its white-box tests run on the class path instead;
           processing-tests exercises the module as a module. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
