<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>be.imgn.gaia</groupId>
    <artifactId>gaia-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>gaia-core</artifactId>

  <name>Gaia Core</name>
  <description>JDK extensions and an event bus, with no dependencies besides JSpecify and the Error Prone annotations.</description>

  <dependencies>
    <!-- The only dependencies gaia-core may have: annotations that are part
         of its published API. Compile scope, not optional, so users' tooling
         sees them: @Nullable/@NullMarked for nullness checkers, and
         @FormatMethod/@FormatString for Error Prone to check the message
         formats passed to Preconditions. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
