<?xml version="1.0" encoding="UTF-8"?>
<!-- Not gaia-parent: an imported BOM contributes its *effective*
     dependencyManagement, inherited entries included, so inheriting from
     gaia-parent would push be.imgn.parent:parent's JUnit, AssertJ and JSpecify
     pins into every user's build. bom-parent manages no dependencies: it only
     gives the plugin versions, the build rules and the release profile. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Bump it with be.imgn.parent:parent in ../pom.xml. -->
  <parent>
    <groupId>be.imgn.parent</groupId>
    <artifactId>bom-parent</artifactId>
    <version>2026-10-17</version>
    <relativePath/>
  </parent>

  <groupId>be.imgn.gaia</groupId>
  <artifactId>gaia-bom</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <!-- Central reads each POM on its own: the metadata is restated, gaia's. -->
  <name>Gaia BOM</name>
  <description>Bill of materials for the gaia libraries: import it to align every gaia module on one version.</description>
  <url>https://github.com/imgn-dev/gaia</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>imgn-dev</id>
      <name>The IMGN developers</name>
      <url>https://github.com/imgn-dev</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/imgn-dev/gaia.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/imgn-dev/gaia.git</developerConnection>
    <url>https://github.com/imgn-dev/gaia</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <!-- ${revision} comes from ../.mvn/maven.config, shared with gaia-parent. -->

    <project.build.outputTimestamp>2026-10-17T19:51:24Z</project.build.outputTimestamp>
    <!-- Same as gaia-parent: bom-parent does not manage flatten. -->
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
  </properties>

  <!-- Only gaia artifacts. Every published module is listed; the unpublished
       *-tests modules are not. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-core-testing</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-events</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-events-processor</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-memfs</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-processing</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>be.imgn.gaia</groupId>
        <artifactId>gaia-processing-testing</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- bom mode keeps dependencyManagement and drops build and profiles.
           It keeps dependencyManagement as written, though, so it is
           interpolated explicitly: otherwise ${revision} reaches the published
           POM unresolved. Properties are dropped: they are build settings, of
           no use to an importing project. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>bom</flattenMode>
          <updatePomFile>true</updatePomFile>
          <outputDirectory>${project.build.directory}</outputDirectory>
          <pomElements>
            <dependencyManagement>interpolate</dependencyManagement>
            <properties>remove</properties>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
